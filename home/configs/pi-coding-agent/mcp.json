{
  "mcpServers": {
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      }
    },
    "GitHits": {
      "command": "npx",
      "args": ["-y", "githits@latest", "mcp", "start"],
      "lifecycle": "eager"
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--executable-path=@chromeExecutable@",
        "--isolated"
      ]
    }
  }
}
