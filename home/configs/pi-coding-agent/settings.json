{
  "retry": {
    "baseDelayMs": 1000,
    "provider": {
      "maxRetryDelayMs": 900000,
      "timeoutMs": 3600000
    }
  },
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.5",
  "defaultThinkingLevel": "xhigh",
  "doubleEscapeAction": "tree",
  "enableSkillCommands": true,
  "enabledModels": ["openai-codex/gpt-5.5", "openai-codex/gpt-5.3-codex-spark"],
  "hideThinkingBlock": true,
  "terminal": {
    "showTerminalProgress": true,
    "imageWidthCells": 120
  },
  "shellCommandPrefix": "export GIT_EDITOR=true\nexport GIT_SEQUENCE_EDITOR=true\nexport GIT_TERMINAL_PROMPT=0",
  "packages": [
    "npm:pi-mcp-adapter",
    "npm:pi-web-access",
    "npm:pi-subagents",
    "npm:pi-caveman",
    "npm:@plannotator/pi-extension",
    "npm:pi-agent-goal",
    "npm:@narumitw/pi-codex-usage",
    "npm:pi-rtk-optimizer"
  ]
}
